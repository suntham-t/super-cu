{
  "name": "dsh-super-cu",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "DSH bundle for Windows desktop control over UI Automation: compact semantic snapshots with stable element ids (cu_show) and batched mouse, keyboard, window and wait/assert actions (cu_do).",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "computer-use",
    "ui-automation",
    "windows",
    "agent",
    "mcp"
  ],
  "icon": "./icon.svg",
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "src/*.py",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "SKILL.md",
    "setup.ps1",
    "CHANGELOG.md",
    "docs/RESEARCH.md",
    "docs/MINIMIZED.md",
    "docs/OPTIMIZATION.md",
    "docs/OPT-BASELINE.md",
    "docs/OPT-AFTER.md",
    "docs/OPT-VERIFY.md",
    "tests/test_server.py",
    "tests/test_bridge.py",
    "bench/opt/bench.py",
    "bench/verify/verify.py"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0"
  }
}
